# Copy to .env.local for local builds. In GitHub Actions these come from repo variables.

# Full origin of the deployed site, including any base path. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://taran-duba.github.io

# Leave unset for <owner>.github.io repos. For a project site, set to "/<repo-name>".
# NEXT_PUBLIC_BASE_PATH=

# Optional, cookie-free analytics. Provider is "goatcounter" or "plausible".
# NEXT_PUBLIC_ANALYTICS_PROVIDER=goatcounter
# NEXT_PUBLIC_ANALYTICS_ID=your-goatcounter-code

# Set to 1 to show TODO placeholders in a production build (for a preview).
# NEXT_PUBLIC_SHOW_TODOS=1
